{
  "extends": ["next/core-web-vitals"],
  "plugins": ["@typescript-eslint"],
  "rules": {
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "ignoreRestSiblings": true }
    ],
    "no-console": ["warn", { "allow": ["error", "warn"] }],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "MemberExpression[object.name='console'][property.name=/^(log|debug|info|trace|dir|table|group|groupEnd|time|timeEnd)$/]",
        "message": "Prefer `logger` from @/lib/logger (centralized dev/prod gating + in-game debug history)."
      }
    ],
    "prefer-const": "warn",
    "no-var": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "react-hooks/rules-of-hooks": "error",
    "react/no-unescaped-entities": "warn"
  },
  "overrides": [
    {
      "files": ["electron/**/*.js"],
      "env": { "node": true, "browser": false },
      "parserOptions": { "sourceType": "script" },
      "rules": {
        "@typescript-eslint/no-unused-vars": "off",
        "@typescript-eslint/no-var-requires": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "dist/",
    "SteamBuild/",
    "remotion/",
    "scripts/"
  ]
}
