{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["error"] }],
    "prefer-const": "warn",
    "no-var": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }]
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "dist/",
    "SteamBuild/",
    "remotion/",
    "electron/",
    "scripts/"
  ]
}
